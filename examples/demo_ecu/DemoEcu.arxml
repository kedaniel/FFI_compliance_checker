<?xml version="1.0" encoding="UTF-8"?>
<!--
  SYNTHETIC demo ECU for learning. Not from any real project.

  Architecture (what this file describes):

    Core0:
      OsApp_AsilC_Core0 (trusted)      -> Task_AsilC_10ms  -> BrakeCtrl_Run10ms    (SWC BrakeCtrl, ASIL C)
      OsApp_QM_Core0    (non-trusted)  -> Task_QM_100ms    -> Diag_Run100ms        (SWC Diagnostics, QM)
    Core1:
      OsApp_AsilC_Core1 (non-trusted)  -> Task_AsilC_5ms   -> SpeedMon_Run5ms      (SWC SpeedMonitor, ASIL C)
                                                           -> Hmi_Run20ms          (SWC HmiGateway, QM)   (seeded issue!)

  Seeded issue: a QM runnable (Hmi_Run20ms) is mapped into an ASIL C partition.
  Core0 also mixes QM and ASIL C partitions on one core (allowed only with proper
  memory/timing protection - later milestones check that).

  Convention: standard AUTOSAR classic has no "ASIL" attribute on a SWC, so we
  store it in a Special Data Group (SDG) with GID="FFI_CHECKER". Real projects
  often do something similar, or keep ASIL in a separate safety database.
-->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>DemoEcu</SHORT-NAME>
      <AR-PACKAGES>

        <!-- ===================== Software components ===================== -->
        <AR-PACKAGE>
          <SHORT-NAME>SwComponentTypes</SHORT-NAME>
          <ELEMENTS>

            <APPLICATION-SW-COMPONENT-TYPE>
              <SHORT-NAME>BrakeCtrl</SHORT-NAME>
              <ADMIN-DATA><SDGS><SDG GID="FFI_CHECKER"><SD GID="ASIL">C</SD></SDG></SDGS></ADMIN-DATA>
              <INTERNAL-BEHAVIORS>
                <SWC-INTERNAL-BEHAVIOR>
                  <SHORT-NAME>BrakeCtrl_IB</SHORT-NAME>
                  <EVENTS>
                    <TIMING-EVENT>
                      <SHORT-NAME>TE_BrakeCtrl_10ms</SHORT-NAME>
                      <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/DemoEcu/SwComponentTypes/BrakeCtrl/BrakeCtrl_IB/BrakeCtrl_Run10ms</START-ON-EVENT-REF>
                      <PERIOD>0.01</PERIOD>
                    </TIMING-EVENT>
                  </EVENTS>
                  <RUNNABLES>
                    <RUNNABLE-ENTITY>
                      <SHORT-NAME>BrakeCtrl_Run10ms</SHORT-NAME>
                      <SYMBOL>BrakeCtrl_Run10ms</SYMBOL>
                    </RUNNABLE-ENTITY>
                  </RUNNABLES>
                </SWC-INTERNAL-BEHAVIOR>
              </INTERNAL-BEHAVIORS>
            </APPLICATION-SW-COMPONENT-TYPE>

            <APPLICATION-SW-COMPONENT-TYPE>
              <SHORT-NAME>SpeedMonitor</SHORT-NAME>
              <ADMIN-DATA><SDGS><SDG GID="FFI_CHECKER"><SD GID="ASIL">C</SD></SDG></SDGS></ADMIN-DATA>
              <INTERNAL-BEHAVIORS>
                <SWC-INTERNAL-BEHAVIOR>
                  <SHORT-NAME>SpeedMonitor_IB</SHORT-NAME>
                  <EVENTS>
                    <TIMING-EVENT>
                      <SHORT-NAME>TE_SpeedMon_5ms</SHORT-NAME>
                      <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/DemoEcu/SwComponentTypes/SpeedMonitor/SpeedMonitor_IB/SpeedMon_Run5ms</START-ON-EVENT-REF>
                      <PERIOD>0.005</PERIOD>
                    </TIMING-EVENT>
                  </EVENTS>
                  <RUNNABLES>
                    <RUNNABLE-ENTITY>
                      <SHORT-NAME>SpeedMon_Run5ms</SHORT-NAME>
                      <SYMBOL>SpeedMon_Run5ms</SYMBOL>
                    </RUNNABLE-ENTITY>
                  </RUNNABLES>
                </SWC-INTERNAL-BEHAVIOR>
              </INTERNAL-BEHAVIORS>
            </APPLICATION-SW-COMPONENT-TYPE>

            <APPLICATION-SW-COMPONENT-TYPE>
              <SHORT-NAME>Diagnostics</SHORT-NAME>
              <ADMIN-DATA><SDGS><SDG GID="FFI_CHECKER"><SD GID="ASIL">QM</SD></SDG></SDGS></ADMIN-DATA>
              <INTERNAL-BEHAVIORS>
                <SWC-INTERNAL-BEHAVIOR>
                  <SHORT-NAME>Diagnostics_IB</SHORT-NAME>
                  <EVENTS>
                    <TIMING-EVENT>
                      <SHORT-NAME>TE_Diag_100ms</SHORT-NAME>
                      <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/DemoEcu/SwComponentTypes/Diagnostics/Diagnostics_IB/Diag_Run100ms</START-ON-EVENT-REF>
                      <PERIOD>0.1</PERIOD>
                    </TIMING-EVENT>
                  </EVENTS>
                  <RUNNABLES>
                    <RUNNABLE-ENTITY>
                      <SHORT-NAME>Diag_Run100ms</SHORT-NAME>
                      <SYMBOL>Diag_Run100ms</SYMBOL>
                    </RUNNABLE-ENTITY>
                  </RUNNABLES>
                </SWC-INTERNAL-BEHAVIOR>
              </INTERNAL-BEHAVIORS>
            </APPLICATION-SW-COMPONENT-TYPE>

            <APPLICATION-SW-COMPONENT-TYPE>
              <SHORT-NAME>HmiGateway</SHORT-NAME>
              <ADMIN-DATA><SDGS><SDG GID="FFI_CHECKER"><SD GID="ASIL">QM</SD></SDG></SDGS></ADMIN-DATA>
              <INTERNAL-BEHAVIORS>
                <SWC-INTERNAL-BEHAVIOR>
                  <SHORT-NAME>HmiGateway_IB</SHORT-NAME>
                  <EVENTS>
                    <TIMING-EVENT>
                      <SHORT-NAME>TE_Hmi_20ms</SHORT-NAME>
                      <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/DemoEcu/SwComponentTypes/HmiGateway/HmiGateway_IB/Hmi_Run20ms</START-ON-EVENT-REF>
                      <PERIOD>0.02</PERIOD>
                    </TIMING-EVENT>
                  </EVENTS>
                  <RUNNABLES>
                    <RUNNABLE-ENTITY>
                      <SHORT-NAME>Hmi_Run20ms</SHORT-NAME>
                      <SYMBOL>Hmi_Run20ms</SYMBOL>
                    </RUNNABLE-ENTITY>
                  </RUNNABLES>
                </SWC-INTERNAL-BEHAVIOR>
              </INTERNAL-BEHAVIORS>
            </APPLICATION-SW-COMPONENT-TYPE>

          </ELEMENTS>
        </AR-PACKAGE>

        <!-- ===================== ECU configuration (BSW) ===================== -->
        <AR-PACKAGE>
          <SHORT-NAME>EcucConfig</SHORT-NAME>
          <ELEMENTS>

            <!-- EcuC: which cores exist -->
            <ECUC-MODULE-CONFIGURATION-VALUES>
              <SHORT-NAME>EcuC</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-MODULE-DEF">/MICROSAR/EcuC</DEFINITION-REF>
              <CONTAINERS>
                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>EcucHardware</SHORT-NAME>
                  <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/MICROSAR/EcuC/EcucHardware</DEFINITION-REF>
                  <SUB-CONTAINERS>
                    <ECUC-CONTAINER-VALUE>
                      <SHORT-NAME>Core0</SHORT-NAME>
                      <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/MICROSAR/EcuC/EcucHardware/EcucCoreDefinition</DEFINITION-REF>
                      <PARAMETER-VALUES>
                        <ECUC-NUMERICAL-PARAM-VALUE>
                          <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/MICROSAR/EcuC/EcucHardware/EcucCoreDefinition/EcucCoreId</DEFINITION-REF>
                          <VALUE>0</VALUE>
                        </ECUC-NUMERICAL-PARAM-VALUE>
                      </PARAMETER-VALUES>
                    </ECUC-CONTAINER-VALUE>
                    <ECUC-CONTAINER-VALUE>
                      <SHORT-NAME>Core1</SHORT-NAME>
                      <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/MICROSAR/EcuC/EcucHardware/EcucCoreDefinition</DEFINITION-REF>
                      <PARAMETER-VALUES>
                        <ECUC-NUMERICAL-PARAM-VALUE>
                          <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/MICROSAR/EcuC/EcucHardware/EcucCoreDefinition/EcucCoreId</DEFINITION-REF>
                          <VALUE>1</VALUE>
                        </ECUC-NUMERICAL-PARAM-VALUE>
                      </PARAMETER-VALUES>
                    </ECUC-CONTAINER-VALUE>
                  </SUB-CONTAINERS>
                </ECUC-CONTAINER-VALUE>
              </CONTAINERS>
            </ECUC-MODULE-CONFIGURATION-VALUES>

            <!-- Os: tasks and OS-Applications (= partitions) -->
            <ECUC-MODULE-CONFIGURATION-VALUES>
              <SHORT-NAME>Os</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-MODULE-DEF">/MICROSAR/Os</DEFINITION-REF>
              <CONTAINERS>
                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>Task_AsilC_10ms</SHORT-NAME>
                  <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/MICROSAR/Os/OsTask</DEFINITION-REF>
                </ECUC-CONTAINER-VALUE>
                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>Task_AsilC_5ms</SHORT-NAME>
                  <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/MICROSAR/Os/OsTask</DEFINITION-REF>
                </ECUC-CONTAINER-VALUE>
                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>Task_QM_100ms</SHORT-NAME>
                  <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/MICROSAR/Os/OsTask</DEFINITION-REF>
                </ECUC-CONTAINER-VALUE>

                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>OsApp_AsilC_Core0</SHORT-NAME>
                  <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/MICROSAR/Os/OsApplication</DEFINITION-REF>
                  <PARAMETER-VALUES>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/MICROSAR/Os/OsApplication/OsTrusted</DEFINITION-REF>
                      <VALUE>true</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                  </PARAMETER-VALUES>
                  <REFERENCE-VALUES>
                    <ECUC-REFERENCE-VALUE>
                      <DEFINITION-REF DEST="ECUC-REFERENCE-DEF">/MICROSAR/Os/OsApplication/OsApplicationCoreRef</DEFINITION-REF>
                      <VALUE-REF DEST="ECUC-CONTAINER-VALUE">/DemoEcu/EcucConfig/EcuC/EcucHardware/Core0</VALUE-REF>
                    </ECUC-REFERENCE-VALUE>
                    <ECUC-REFERENCE-VALUE>
                      <DEFINITION-REF DEST="ECUC-REFERENCE-DEF">/MICROSAR/Os/OsApplication/OsAppTaskRef</DEFINITION-REF>
                      <VALUE-REF DEST="ECUC-CONTAINER-VALUE">/DemoEcu/EcucConfig/Os/Task_AsilC_10ms</VALUE-REF>
                    </ECUC-REFERENCE-VALUE>
                  </REFERENCE-VALUES>
                </ECUC-CONTAINER-VALUE>

                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>OsApp_QM_Core0</SHORT-NAME>
                  <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/MICROSAR/Os/OsApplication</DEFINITION-REF>
                  <PARAMETER-VALUES>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/MICROSAR/Os/OsApplication/OsTrusted</DEFINITION-REF>
                      <VALUE>false</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                  </PARAMETER-VALUES>
                  <REFERENCE-VALUES>
                    <ECUC-REFERENCE-VALUE>
                      <DEFINITION-REF DEST="ECUC-REFERENCE-DEF">/MICROSAR/Os/OsApplication/OsApplicationCoreRef</DEFINITION-REF>
                      <VALUE-REF DEST="ECUC-CONTAINER-VALUE">/DemoEcu/EcucConfig/EcuC/EcucHardware/Core0</VALUE-REF>
                    </ECUC-REFERENCE-VALUE>
                    <ECUC-REFERENCE-VALUE>
                      <DEFINITION-REF DEST="ECUC-REFERENCE-DEF">/MICROSAR/Os/OsApplication/OsAppTaskRef</DEFINITION-REF>
                      <VALUE-REF DEST="ECUC-CONTAINER-VALUE">/DemoEcu/EcucConfig/Os/Task_QM_100ms</VALUE-REF>
                    </ECUC-REFERENCE-VALUE>
                  </REFERENCE-VALUES>
                </ECUC-CONTAINER-VALUE>

                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>OsApp_AsilC_Core1</SHORT-NAME>
                  <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/MICROSAR/Os/OsApplication</DEFINITION-REF>
                  <PARAMETER-VALUES>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/MICROSAR/Os/OsApplication/OsTrusted</DEFINITION-REF>
                      <VALUE>false</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                  </PARAMETER-VALUES>
                  <REFERENCE-VALUES>
                    <ECUC-REFERENCE-VALUE>
                      <DEFINITION-REF DEST="ECUC-REFERENCE-DEF">/MICROSAR/Os/OsApplication/OsApplicationCoreRef</DEFINITION-REF>
                      <VALUE-REF DEST="ECUC-CONTAINER-VALUE">/DemoEcu/EcucConfig/EcuC/EcucHardware/Core1</VALUE-REF>
                    </ECUC-REFERENCE-VALUE>
                    <ECUC-REFERENCE-VALUE>
                      <DEFINITION-REF DEST="ECUC-REFERENCE-DEF">/MICROSAR/Os/OsApplication/OsAppTaskRef</DEFINITION-REF>
                      <VALUE-REF DEST="ECUC-CONTAINER-VALUE">/DemoEcu/EcucConfig/Os/Task_AsilC_5ms</VALUE-REF>
                    </ECUC-REFERENCE-VALUE>
                  </REFERENCE-VALUES>
                </ECUC-CONTAINER-VALUE>
              </CONTAINERS>
            </ECUC-MODULE-CONFIGURATION-VALUES>

            <!-- Rte: which runnable (via its event) runs in which task -->
            <ECUC-MODULE-CONFIGURATION-VALUES>
              <SHORT-NAME>Rte</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-MODULE-DEF">/MICROSAR/Rte</DEFINITION-REF>
              <CONTAINERS>
                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>RteSwComponentInstances</SHORT-NAME>
                  <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/MICROSAR/Rte/RteSwComponentInstance</DEFINITION-REF>
                  <SUB-CONTAINERS>
                    <ECUC-CONTAINER-VALUE>
                      <SHORT-NAME>Map_BrakeCtrl_10ms</SHORT-NAME>
                      <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/MICROSAR/Rte/RteSwComponentInstance/RteEventToTaskMapping</DEFINITION-REF>
                      <REFERENCE-VALUES>
                        <ECUC-FOREIGN-REFERENCE-VALUE>
                          <DEFINITION-REF DEST="ECUC-FOREIGN-REFERENCE-DEF">/MICROSAR/Rte/RteSwComponentInstance/RteEventToTaskMapping/RteEventRef</DEFINITION-REF>
                          <VALUE-REF DEST="TIMING-EVENT">/DemoEcu/SwComponentTypes/BrakeCtrl/BrakeCtrl_IB/TE_BrakeCtrl_10ms</VALUE-REF>
                        </ECUC-FOREIGN-REFERENCE-VALUE>
                        <ECUC-REFERENCE-VALUE>
                          <DEFINITION-REF DEST="ECUC-REFERENCE-DEF">/MICROSAR/Rte/RteSwComponentInstance/RteEventToTaskMapping/RteMappedToTaskRef</DEFINITION-REF>
                          <VALUE-REF DEST="ECUC-CONTAINER-VALUE">/DemoEcu/EcucConfig/Os/Task_AsilC_10ms</VALUE-REF>
                        </ECUC-REFERENCE-VALUE>
                      </REFERENCE-VALUES>
                    </ECUC-CONTAINER-VALUE>
                    <ECUC-CONTAINER-VALUE>
                      <SHORT-NAME>Map_SpeedMon_5ms</SHORT-NAME>
                      <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/MICROSAR/Rte/RteSwComponentInstance/RteEventToTaskMapping</DEFINITION-REF>
                      <REFERENCE-VALUES>
                        <ECUC-FOREIGN-REFERENCE-VALUE>
                          <DEFINITION-REF DEST="ECUC-FOREIGN-REFERENCE-DEF">/MICROSAR/Rte/RteSwComponentInstance/RteEventToTaskMapping/RteEventRef</DEFINITION-REF>
                          <VALUE-REF DEST="TIMING-EVENT">/DemoEcu/SwComponentTypes/SpeedMonitor/SpeedMonitor_IB/TE_SpeedMon_5ms</VALUE-REF>
                        </ECUC-FOREIGN-REFERENCE-VALUE>
                        <ECUC-REFERENCE-VALUE>
                          <DEFINITION-REF DEST="ECUC-REFERENCE-DEF">/MICROSAR/Rte/RteSwComponentInstance/RteEventToTaskMapping/RteMappedToTaskRef</DEFINITION-REF>
                          <VALUE-REF DEST="ECUC-CONTAINER-VALUE">/DemoEcu/EcucConfig/Os/Task_AsilC_5ms</VALUE-REF>
                        </ECUC-REFERENCE-VALUE>
                      </REFERENCE-VALUES>
                    </ECUC-CONTAINER-VALUE>
                    <ECUC-CONTAINER-VALUE>
                      <SHORT-NAME>Map_Diag_100ms</SHORT-NAME>
                      <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/MICROSAR/Rte/RteSwComponentInstance/RteEventToTaskMapping</DEFINITION-REF>
                      <REFERENCE-VALUES>
                        <ECUC-FOREIGN-REFERENCE-VALUE>
                          <DEFINITION-REF DEST="ECUC-FOREIGN-REFERENCE-DEF">/MICROSAR/Rte/RteSwComponentInstance/RteEventToTaskMapping/RteEventRef</DEFINITION-REF>
                          <VALUE-REF DEST="TIMING-EVENT">/DemoEcu/SwComponentTypes/Diagnostics/Diagnostics_IB/TE_Diag_100ms</VALUE-REF>
                        </ECUC-FOREIGN-REFERENCE-VALUE>
                        <ECUC-REFERENCE-VALUE>
                          <DEFINITION-REF DEST="ECUC-REFERENCE-DEF">/MICROSAR/Rte/RteSwComponentInstance/RteEventToTaskMapping/RteMappedToTaskRef</DEFINITION-REF>
                          <VALUE-REF DEST="ECUC-CONTAINER-VALUE">/DemoEcu/EcucConfig/Os/Task_QM_100ms</VALUE-REF>
                        </ECUC-REFERENCE-VALUE>
                      </REFERENCE-VALUES>
                    </ECUC-CONTAINER-VALUE>
                    <!-- Seeded issue: QM runnable mapped into an ASIL C task -->
                    <ECUC-CONTAINER-VALUE>
                      <SHORT-NAME>Map_Hmi_20ms</SHORT-NAME>
                      <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/MICROSAR/Rte/RteSwComponentInstance/RteEventToTaskMapping</DEFINITION-REF>
                      <REFERENCE-VALUES>
                        <ECUC-FOREIGN-REFERENCE-VALUE>
                          <DEFINITION-REF DEST="ECUC-FOREIGN-REFERENCE-DEF">/MICROSAR/Rte/RteSwComponentInstance/RteEventToTaskMapping/RteEventRef</DEFINITION-REF>
                          <VALUE-REF DEST="TIMING-EVENT">/DemoEcu/SwComponentTypes/HmiGateway/HmiGateway_IB/TE_Hmi_20ms</VALUE-REF>
                        </ECUC-FOREIGN-REFERENCE-VALUE>
                        <ECUC-REFERENCE-VALUE>
                          <DEFINITION-REF DEST="ECUC-REFERENCE-DEF">/MICROSAR/Rte/RteSwComponentInstance/RteEventToTaskMapping/RteMappedToTaskRef</DEFINITION-REF>
                          <VALUE-REF DEST="ECUC-CONTAINER-VALUE">/DemoEcu/EcucConfig/Os/Task_AsilC_5ms</VALUE-REF>
                        </ECUC-REFERENCE-VALUE>
                      </REFERENCE-VALUES>
                    </ECUC-CONTAINER-VALUE>
                  </SUB-CONTAINERS>
                </ECUC-CONTAINER-VALUE>
              </CONTAINERS>
            </ECUC-MODULE-CONFIGURATION-VALUES>

          </ELEMENTS>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
