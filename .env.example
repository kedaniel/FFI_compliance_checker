# Neo4j connection settings for the FFI checker.
#
# HOW TO USE
#   1. Copy this file to a new file called ".env" (same folder).
#        PowerShell:  Copy-Item .env.example .env
#   2. Fill in your values in ".env".
#   3. Done. The tool reads ".env" automatically when you run it from this folder.
#
# ".env" is in .gitignore, so your password is never committed to GitHub.
# Never put a real password in THIS file (.env.example), because it IS committed.

# --- Option A: Neo4j Aura Free (cloud). Use ONLY with the synthetic demo data. ---
# Copy the Connection URI and password from the credentials file Aura gave you.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=paste-your-aura-password-here

# --- Option B: local Neo4j (Docker / Neo4j Desktop). Use this for real project data. ---
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=ffi-checker-dev

# --- LLM for milestone 5 (explanations). Any OpenAI-compatible server works. ---
# Default: Ollama on this computer. For a customer's own LLM, change these three lines only.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=ollama
# LLM_OUTPUT_MODE=prompted     # or "tool" if the server supports function calling
# LLM_TIMEOUT=180
